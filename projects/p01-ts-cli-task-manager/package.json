{
  "name": "p01-ts-cli-task-manager",
  "version": "1.0.0",
  "description": "Project P01 — a fully type-safe command-line task manager (TypeScript + Vitest).",
  "type": "module",
  "bin": {
    "tasks": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["typescript", "cli", "course"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
